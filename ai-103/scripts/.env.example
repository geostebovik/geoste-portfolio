# WHAT THIS FILE IS: see the .env explanation in chat if you haven't read it
# yet. Short version -- copy this to a new file named exactly ".env" in this
# same folder, then replace each value below with your real one. ".env" (not
# ".env.example") must be listed in the repo's .gitignore -- verify that
# before running the script.

# --- AIF_ACCOUNT ---
# The Foundry/Cognitive Services account name.
# Verify with: az cognitiveservices account list --resource-group rg-iip-dev-wus-01 -o table
AIF_ACCOUNT=aif-dev-wus-01

# --- AIF_PROJECT_ENDPOINT ---
# The endpoint URL for the AIF project.
# Typically in the format: https://<aif_account>.cognitiveservices.azure.com/
AIF_PROJECT_ENDPOINT=https://aif-iip-dev-wus-01.services.ai.azure.com/api/projects/proj-iip-dev-wus-01

# --- AIF_RESOURCE_GROUP ---
# Verify with: az group list --query "[?contains(name,'iip')]" -o table
AIF_RESOURCE_GROUP=rg-iip-dev-wus-01

# --- STORAGE_ACCOUNT ---
# Only required if you use --blob instead of --file.
# Verify with: az storage account list --resource-group rg-iip-dev-wus-01 -o table
STORAGE_ACCOUNT=stiipdevwus01

# --- ANALYZER_ID ---
# From infrastructure/content-understanding/loan-agreement-analyzer.json's
# "analyzerId" field (same repo, one level up from this scripts/ folder).
ANALYZER_ID=iip_loan_agreement_analyzer

# --- API_VERSION ---
# From iip-cli-runbook.md's proven submit command. Script defaults to this
# same value if the line is omitted, but keep it explicit so there's one
# place to update if Microsoft ships a new GA version.
API_VERSION=2025-11-01

# --- CHAT_API_VERSION ---
# Chat Completions API version is different than that of the Content Understanding API
# as verified via MSFT Learn documentation.
CHAT_API_VERSION=2024-06-01

# --- CHAT_DEPLOYMENT_GPT_5_4 ---
# Deployment name for the GPT-5.4 candidate model. See STATUS.md's "Key
# resources" table if you need the underlying model version (2026-03-05)
# for reference.
CHAT_DEPLOYMENT_GPT_5_4=gpt-5-4

# --- CHAT_DEPLOYMENT_GPT_5_4_MINI ---
# Deployment name for the GPT-5.4 mini candidate model. See STATUS.md's "Key
# resources" table if you need the underlying model version (2026-03-17)
# for reference.
CHAT_DEPLOYMENT_GPT_5_4_MINI=gpt-5-4-mini

# --- CHAT_DEPLOYMENT_GPT_5_2 ---
# Deployment name for the GPT-5.2 judge model used by the evaluation
# harness (m6_evaluate.py, m7_evaluator_tool.py) to score drafted
# content for groundedness/relevance. Not a candidate model being
# evaluated itself -- it's the LLM that grades the other two.
CHAT_DEPLOYMENT_GPT_5_2=gpt-5-2

# --- SEARCH_SERVICE ---
# Azure AI Search service name (Free tier, West US), provisioned Aug 7 for
# M5. Verify with: az search service list --resource-group rg-iip-dev-wus-01 -o table
# Endpoint is the fixed https://<service>.search.windows.net pattern --
# built from this name, not fetched via az. Only the admin key is fetched
# live (see get_search_admin_key() in m5_index.py).
SEARCH_SERVICE=srch-iip-dev-wus-01

# --- SEARCH_INDEX_NAME ---
# Design locked Aug 7 (STATUS.md): fields id/section/content/contentVector,
# 16 documents (15 roman-numeral sections + signature block).
SEARCH_INDEX_NAME=loan-agreement-index

# --- EMBEDDING_DEPLOYMENT ---
# Deployment name for text-embedding-3-small in aif-dev-wus-01. See
# STATUS.md's "Key resources" table.
EMBEDDING_DEPLOYMENT=text-embedding-3-small

# --- PF_WORKER_COUNT ---
# Read by azure-ai-evaluation's batch engine to override max_concurrency
# (default 10). evaluate() runs each AI-assisted evaluator as its own
# concurrent batch job, so the default lets ~30 simultaneous requests hit
# the judge deployment at once -- confirmed via a real 429 storm, Aug 5.
# Lower this further if you still see rate limits; raise it if the judge
# deployment's capacity increases.
PF_WORKER_COUNT=2